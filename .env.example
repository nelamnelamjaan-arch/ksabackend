# Public browser origins allowed for CORS + Socket.io (comma-separated)
#
# Vercel (ksabackend): do NOT set PORT — serverless uses api/index.js, not src/index.js listen.
# Set CLIENT_ORIGIN to your live client URL(s). Code also merges https://ksafrontend.vercel.app on Vercel.
#
# Local dev:
# CLIENT_ORIGIN=http://localhost:5173
# Local + production client:
CLIENT_ORIGIN=http://localhost:5173,https://ksafrontend.vercel.app

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/ksa-store

# JWT
JWT_SECRET=change-me-in-production

# Super Admin (Kiran) — seeded on startup + JWT login
ADMIN_USERNAME=Kiran
ADMIN_PASSWORD=kiran123
KIRAN_ADMIN_PASSWORD=kiran123

# --- Tier 1: Official affiliate APIs (hybrid ingestion) ---
# Amazon Product Advertising API 5.0
AMAZON_ASSOCIATE_TAG=
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
# AMAZON_PAAPI_SYNC_LIMIT=20
# AMAZON_PAAPI_TERM_DELAY_MS=1500
# AMAZON_PAAPI_TIMEOUT_MS=30000

# AliExpress Open Platform (affiliate)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
# ALIEXPRESS_TRACKING_ID=
# ALIEXPRESS_API_BASE=https://api-sg.aliexpress.com/sync

# Hybrid ingestion cron + CLI: npm run sync:hybrid-ingest | npm run sync:geo
# HYBRID_INGEST_SYNC_LIMIT=20
# HYBRID_INGEST_CRON_LIMIT=6
# LIVE_FETCH_TIMEOUT_MS=12000
# LIVE_FETCH_STALE_HOURS=6

# Universal import / Auto-Pilot / production catalogue sync
RAINFOREST_API_KEY=
# RAINFOREST_SYNC_LIMIT=8
# RAINFOREST_SYNC_DRY_RUN=false
# RAINFOREST_SYNC_BULK=true
# RAINFOREST_FULFILLMENT_WEBHOOK_URL=https://your-ops-endpoint/webhooks/dropship
# Catalogue sync margin: 30% default (wholesale × 1.30). Set CATALOG_SYNC_USE_PLATFORM_MARGIN=true to use PlatformSettings instead.
CATALOG_SYNC_MARGIN_PERCENT=30
# SERP_CATALOG_SYNC_LIMIT=6
# SERP_CATALOG_TERM_DELAY_MS=1200
# Direct HTML scrape (Tier 2b) — Amazon / Noon / Google Shopping (no SerpAPI required)
# npm run sync:direct-scrape          — single-market, legacy page depth
# npm run sync:direct-scrape:bulk     — enterprise: pagination + bulkWrite + multi-market
# DIRECT_HTML_SCRAPE_DISABLED=true
# DIRECT_SCRAPE_ONLY=true
# DIRECT_SCRAPE_ENTERPRISE=true
# DIRECT_SCRAPE_BULK=true
# DIRECT_SCRAPE_SYNC_LIMIT=24
# DIRECT_SCRAPE_MAX_PAGES=8
# DIRECT_SCRAPE_PER_PAGE=16
# Config-driven scrape targets (enterprise + hybrid Tier 2b)
# SCRAPE_PLATFORMS=amazon,noon,ebay,aliexpress
# SCRAPE_REGIONS=SA,US,UK,UAE,AE
# Phased lakh-scale sync: npm run sync:enterprise-scale -- --batch 1
# ENTERPRISE_SYNC_TARGET=100000
# ENTERPRISE_SYNC_BATCH=1
# Legacy alias (AE maps to UAE): DIRECT_SCRAPE_MARKETS=SA,US,AE
# DIRECT_SCRAPE_MAX_PAGES=8
# DIRECT_SCRAPE_MIN_DELAY_MS=1000
# DIRECT_SCRAPE_MAX_DELAY_MS=2500
# DIRECT_SCRAPE_TERM_DELAY_MS=1800
# DIRECT_SCRAPE_TIMEOUT_MS=28000
# DIRECT_SCRAPE_PERSIST_BATCH_SIZE=20
# DIRECT_SCRAPE_PERSIST_BATCH_DELAY_MS=300
#
# Enterprise scale (garments + food) — npm run sync:enterprise-scale
# Realistic per-run cap (not 100k in one shot). Repeat with --resume to grow toward lakhs.
# ENTERPRISE_SYNC_TARGET=5000
ENTERPRISE_USE_REAL_ONLY=true
# DIRECT_SCRAPE_ONLY=true
# ENTERPRISE_CATEGORY_DELAY_MS=1200
# npm run sync:enterprise-scale -- --test-batch
# npm run sync:enterprise-scale -- --categories all --pages 10 --food-pages 4 --limit-per-page 20
# npm run sync:direct-scrape:bulk -- --categories all --pages 10 --limit 20 --per-page 20
SERPAPI_API_KEY=
# Alias supported in code (use one or the other)
SERP_API_KEY=
GEMINI_API_KEY=
# GOOGLE_AI_API_KEY=
FIXER_API_KEY=
# Live FX (preferred) — https://www.exchangerate-api.com
EXCHANGERATE_API_KEY=
# Global parcel tracking — https://www.aftership.com/docs/tracking/quickstart/api-quick-start
AFTERSHIP_API_KEY=

# Transactional email (Resend) — glass templates: order / payment / shipping
# Set keys in .env only — never commit secrets
RESEND_API_KEY=
RESEND_FROM="KSA Store <orders@ksastore.com>"
# Logo in confirmation emails (defaults to PUBLIC_SITE_URL/favicon.svg)
# KSA_STORE_LOGO_URL=
# Production storefront: https://ksafrontend.vercel.app
PUBLIC_SITE_URL=http://localhost:5173
# Scraper anti-block (optional): comma-separated http proxies
# SCRAPE_PROXY_URLS=http://user:pass@proxy1:8080,http://user:pass@proxy2:8080
# SCRAPE_UA_ROTATION=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_PRODUCT_VIDEO_FOLDER=ksa-store/product-videos

# Product reel videos (Shotstack) — POST https://api.shotstack.io/edit/v1/render
SHOTSTACK_API_KEY=
# v1 = production | stage = sandbox (SHOTSTACK_ENV aliases SHOTSTACK_API_VERSION)
SHOTSTACK_API_VERSION=v1
# SHOTSTACK_ENV=stage
# MP3 URL for background music on generated reels
SHOTSTACK_SOUNDTRACK_URL=
VIDEO_GENERATOR_ENABLED=true
PRODUCT_VIDEO_DURATION_SEC=15
# VIDEO_REGENERATE_ON_IMPORT=true

# Auto-Pilot cron (price/stock every 6h; OOS → status hidden)
ENABLE_CRON_AUTOPILOT=true
CRON_AUTOPILOT_RUN_ON_BOOT=true
# Live price/stock re-scrape (sourceUrl + automation.scrapedFromUrl) — also on when ENABLE_CRON_AUTOPILOT=true
ENABLE_LIVE_PRICE_SYNC_CRON=true
# LIVE_PRICE_SYNC_RUN_ON_BOOT=false
# LIVE_PRICE_SYNC_LIMIT=500
# Midnight Asia/Riyadh: Rainforest inventory + Auto-Pilot + daily profit email (requires ENABLE_DAILY_PROFIT_REPORT)
ENABLE_CRON_MIDNIGHT_PIPELINE=true
# CRON_MIDNIGHT_PIPELINE_SCHEDULE=0 0 * * *
# CRON_MIDNIGHT_RUN_ON_BOOT=false
# RAINFOREST_CRON_LIMIT=6

# Top-sellers price refresh (daily — paid-order rank, re-scrape source price)
ENABLE_CRON_TOP_SELLERS_PRICE_REFRESH=false
# Default: 04:00 daily (cron expression, Asia/Riyadh via CRON_TIMEZONE)
CRON_TOP_SELLERS_SCHEDULE=0 4 * * *
CRON_TOP_SELLERS_RUN_ON_BOOT=false
TOP_SELLING_PRICE_REFRESH_LIMIT=50
TOP_SELLING_PRICE_LOOKBACK_DAYS=90

# Daily profit report (midnight Asia/Riyadh when ENABLE_CRON_MIDNIGHT_PIPELINE=true)
ENABLE_DAILY_PROFIT_REPORT=true
CRON_TIMEZONE=Asia/Riyadh
# CRON_DAILY_PROFIT_SCHEDULE=0 0 * * *
DAILY_PROFIT_REPORT_TO=Usmanrahmaa6@gmail.com
# Optional CC (comma-separated)
DAILY_PROFIT_REPORT_CC=nelamnelamjaan@gmail.com
# Production admin UI: https://ksafrontend.vercel.app
ADMIN_DASHBOARD_URL=http://localhost:5173

# SMTP (Gmail app password, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KSA Store <noreply@ksastore.com>"

# Geolocation (ipapi.co free tier — no API key) — city + country on every request
GEO_USE_IPAPI=true
# Cron stock sync: prefer Daily Essentials vendors for this ISO country (e.g. TR, US, SA)
# Geo catalog sync (Rainforest + SerpApi) — primary Amazon footprint per country
STOREFRONT_SYNC_COUNTRY=SA

# Scheduled scrape (axios + cheerio) — daily at 00:00 in CRON_TIMEZONE (default Asia/Riyadh, not UTC)
# Requires a long-running Node process (npm start / PM2 / Docker). Not supported on Vercel serverless cron.
ENABLE_SCRAPE_CRON=false
# CRON_SCRAPE_SCHEDULE=0 0 * * *
# CRON_SCRAPE_RUN_ON_BOOT=false
# Auto-approve new listings from scheduled scrape (default: pending review)
# SCRAPE_AUTO_APPROVE=false

# AI self-healing scrape (axios + Gemini) — same midnight schedule; GEMINI_API_KEY or GOOGLE_AI_API_KEY required
ENABLE_AI_SCRAPE_CRON=false
# CRON_AI_SCRAPE_SCHEDULE=0 0 * * *
# CRON_AI_SCRAPE_RUN_ON_BOOT=false
# GEMINI_AI_SCRAPE_MODEL=gemini-1.5-flash
# AI_SCRAPE_AUTO_APPROVE=false
# AI_SCRAPE_MAX_HTML_CHARS=120000

# Global marketplace + brand scrape (axios + Gemini, 500+ URLs from scrapedWebsites.js)
ENABLE_GLOBAL_SCRAPE_CRON=false
# CRON_GLOBAL_SCRAPE_SCHEDULE=0 0 * * *
# CRON_GLOBAL_SCRAPE_RUN_ON_BOOT=false
# GLOBAL_SCRAPE_BOOT_LIMIT=5
# GLOBAL_SCRAPE_DELAY_MS=2000
# GEMINI_GLOBAL_SCRAPE_MODEL=gemini-1.5-flash
# GLOBAL_SCRAPE_MAX_HTML_CHARS=100000
# GLOBAL_SCRAPE_AUTO_APPROVE=false

# Open Food Facts + openFDA catalogue sync (no scraping; placeholder price until manual/retail pricing)
# OPEN_API_SYNC_LIMIT=24
# OPEN_API_DEFAULT_PRICE_NATIVE=9.99
# OPEN_API_DEFAULT_CURRENCY=USD
# OPEN_FOOD_FACTS_USER_AGENT=KSAStore - Node.js App - Contact: your-email@example.com
# Bulk hybrid import: npm run sync:hybrid:bulk  (or SYNC_BULK_MODE=true / OPEN_API_SYNC_BULK=true)
# SYNC_BULK_MODE=true
# OPEN_API_SYNC_BULK=true
# OPEN_API_BULK_PER_CATEGORY=40
# OPEN_API_OFF_MAX_PAGES=4
# OPEN_API_DUMMYJSON_MAX_PAGES=5
# OPEN_API_FDA_MAX_PAGES=2
# OPEN_API_PAGE_DELAY_MS=1500
# OPEN_API_PERSIST_BATCH_SIZE=15
# OPEN_API_PERSIST_BATCH_DELAY_MS=300
GLOBAL_SCRAPE_AUTO_APPROVE=true

# Open Shop — seller storefronts at /shops/:slug (default on when unset)
ENABLE_OPEN_SHOP=true

# Universal Checkout — PayPal Live (set credentials in .env only)
PAYPAL_CLIENT_ID=your_live_client_id
PAYPAL_CLIENT_SECRET=your_live_secret
# PAYPAL_SECRET_KEY=your_live_secret
PAYPAL_MODE=live
PAYPAL_DEFAULT_AMOUNT=100.00
# Checkout button currency (USD for global; set SAR + SA geo for domestic)
PAYPAL_CHECKOUT_CURRENCY=USD
PAYPAL_PROFIT_RECEIVER_EMAIL=Usmanrahmaa6@gmail.com
# PAYPAL_PAYOUT_EMAIL=alias for profit receiver
PAYPAL_PAYOUTS_ENABLED=true
# PayPal Developer → Webhooks → https://YOUR_API_HOST/api/webhooks/paypal
PAYPAL_WEBHOOK_ID=
# PAYPAL_WEBHOOK_SKIP_VERIFY=true
# Headless supplier fulfillment (unified worker — stops before supplier payment unless SUPPLIER_AUTO_PAY=true)
ENABLE_AUTOMATED_FULFILLMENT=false
# Local OCR CAPTCHA solver (tesseract.js — defaults on when fulfillment enabled; Amazon image CAPTCHAs may still fail)
ENABLE_LOCAL_CAPTCHA_SOLVER=true
# SUPPLIER_AMAZON_EMAIL=
# SUPPLIER_AMAZON_PASSWORD=
# SUPPLIER_NOON_EMAIL=
# SUPPLIER_NOON_PASSWORD=
# SUPPLIER_AUTO_PAY=false
# FULFILLMENT_ALERT_EMAIL=
# Legacy: AMAZON_BUYER_*, NOON_BUYER_*, ENABLE_*_AUTO_FULFILLMENT
ENABLE_SOURCE_BUY_ASSIST=false
BANK_DETAILS_PK=JazzCash: …|SadaPay: …
BANK_DETAILS_SA=Bank name: …|IBAN: …

# Optional
GOOGLE_CLIENT_ID=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
REDIS_URL=
